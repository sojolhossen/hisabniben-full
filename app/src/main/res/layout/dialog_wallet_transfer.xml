<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/surface">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="টাকা ট্রান্সফার (Account Transfer)"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <!-- Source Account -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilSourceAccount"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="উৎস অ্যাকাউন্ট (From Account)"
        android:layout_marginBottom="12dp">

        <AutoCompleteTextView
            android:id="@+id/actvSourceAccount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Source Balance Hint -->
    <TextView
        android:id="@+id/tvSourceBalanceHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="বর্তমান ব্যালেন্স: ৳0"
        android:textColor="@color/brand_green"
        android:textSize="12sp"
        android:layout_marginBottom="12dp" />

    <!-- Transfer Arrow Icon -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⬇️ ট্রান্সফার ⬇️"
        android:textSize="14sp"
        android:textColor="@color/purple"
        android:layout_gravity="center"
        android:layout_marginBottom="12dp" />

    <!-- Destination Account -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilDestAccount"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="গন্তব্য অ্যাকাউন্ট (To Account)"
        android:layout_marginBottom="12dp">

        <AutoCompleteTextView
            android:id="@+id/actvDestAccount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Amount -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilTransferAmount"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="ট্রান্সফারের পরিমাণ (৳)"
        android:layout_marginBottom="12dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etTransferAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:textSize="18sp"
            android:textStyle="bold" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Reference / Note -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilTransferNote"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="নোট / রেফারেন্স (ঐচ্ছিক)"
        android:layout_marginBottom="16dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etTransferNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Submit Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSubmitTransfer"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="↔️ টাকা ট্রান্সফার করুন"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="12dp"
        app:backgroundTint="@color/purple" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="12dp"
        android:visibility="gone" />

</LinearLayout>
