<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/surface"
    app:strokeColor="@color/divider"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Direction Icon Indicator -->
            <TextView
                android:id="@+id/tvTxDirectionIcon"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:gravity="center"
                android:textSize="18sp"
                android:text="↑"
                android:textColor="@color/brand_green"
                android:background="@drawable/bg_rounded_light_green" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <TextView
                    android:id="@+id/tvTxTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="রহিমের কাছ থেকে টাকা জমা"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:ellipsize="end"
                    android:maxLines="1" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical">

                    <!-- Category Badge -->
                    <TextView
                        android:id="@+id/tvTxCategory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Customer Payment"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:background="#F3F4F6" />

                    <!-- Account Name Badge -->
                    <TextView
                        android:id="@+id/tvTxAccount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cash"
                        android:textColor="@color/primary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginStart="6dp"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:background="#FFF0ED" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:id="@+id/tvTxAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+৳10,000"
                    android:textColor="@color/brand_green"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTxRunningBalance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ব্যালেন্স: ৳45,000"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp" />

            </LinearLayout>
        </LinearLayout>

        <!-- Bottom Row: Date/Time & Status -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingTop="6dp"
            android:background="@drawable/bg_top_divider">

            <TextView
                android:id="@+id/tvTxDateTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="26 Aug 2026, 06:30 PM"
                android:textColor="@color/text_hint"
                android:textSize="11sp"
                android:layout_alignParentStart="true" />

            <TextView
                android:id="@+id/tvTxStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="সম্পন্ন"
                android:textColor="@color/brand_green"
                android:textSize="11sp"
                android:layout_alignParentEnd="true" />
        </RelativeLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
